# ==============================================================================
# Environment Configuration Template (.env.example)
#
# Copy this file to .env and customize values for your deployment.
# Variables with defaults can be left as-is for local development.
# Sensitive secrets (API keys, passwords, private tokens) must be populated.
# ==============================================================================

# Core System & Runtime Paths
APP_ENV=development
PORT=8080
LOG_LEVEL=info
DATA_DIR=./data

# User and Group Identity (for non-root least-privilege execution)
PUID=1000
PGID=100
TZ=UTC

# Application Secrets (Must be set in production; auto-generated if blank during setup)
SECRET_KEY=
API_TOKEN=

# Database / Cache Configuration
DATABASE_URL=postgres://app_user:password@localhost:5432/app_db
REDIS_URL=redis://localhost:6379/0
